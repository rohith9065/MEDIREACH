{
  "name": "@medireach/server",
  "version": "0.1.0",
  "private": true,
  "main": "dist/server/src/server.js",
  "scripts": {
    "dev": "ts-node-dev --respawn --transpile-only -r dotenv/config src/server.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node -r dotenv/config dist/server/src/server.js",
    "migrate": "dotenv -e .env -- node-pg-migrate up -m ../database/migrations -j ts --tsconfig ./tsconfig.json",
    "migrate:down": "dotenv -e .env -- node-pg-migrate down -m ../database/migrations -j ts --tsconfig ./tsconfig.json",
    "seed": "npm run seed:users && npm run seed:hospital && npm run seed:more-hospitals && npm run seed:real-hospitals && npm run seed:ambulances && npm run seed:karur-dataset",
    "seed:users": "dotenv -e .env -- ts-node --project ./tsconfig.json --transpile-only ../database/seeds/001_seed_users.ts",
    "seed:hospital": "dotenv -e .env -- ts-node --project ./tsconfig.json --transpile-only ../database/seeds/002_seed_hospital.ts",
    "seed:more-hospitals": "dotenv -e .env -- ts-node --project ./tsconfig.json --transpile-only ../database/seeds/003_seed_more_hospitals.ts",
    "seed:real-hospitals": "dotenv -e .env -- ts-node --project ./tsconfig.json --transpile-only ../database/seeds/004_seed_real_hospitals.ts",
    "seed:ambulances": "dotenv -e .env -- ts-node --project ./tsconfig.json --transpile-only ../database/seeds/005_seed_ambulances.ts",
    "seed:karur-dataset": "dotenv -e .env -- ts-node --project ./tsconfig.json --transpile-only ../database/seeds/006_seed_karur_dataset.ts",
    "migrate:test": "dotenv -e .env -- ts-node --transpile-only scripts/migrate-test.ts",
    "pretest": "npm run migrate:test",
    "test": "cross-env NODE_ENV=test jest --runInBand",
    "lint": "tsc --noEmit"
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "express-rate-limit": "^7.4.0",
    "helmet": "^7.1.0",
    "jsonwebtoken": "^9.0.2",
    "pg": "^8.12.0",
    "socket.io": "^4.7.5",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/jest": "^29.5.12",
    "@types/jsonwebtoken": "^9.0.6",
    "@types/node": "^20.14.10",
    "@types/pg": "^8.11.6",
    "@types/supertest": "^6.0.2",
    "cross-env": "^7.0.3",
    "dotenv-cli": "^7.4.2",
    "jest": "^29.7.0",
    "node-pg-migrate": "^7.6.1",
    "socket.io-client": "^4.8.3",
    "supertest": "^7.0.0",
    "ts-jest": "^29.2.2",
    "ts-node": "^10.9.2",
    "ts-node-dev": "^2.0.0",
    "typescript": "^5.5.3"
  }
}
