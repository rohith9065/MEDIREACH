# ── Server ────────────────────────────────────────────────
PORT=4000
NODE_ENV=production

# ── Database ──────────────────────────────────────────────
# Connection string from your managed Postgres provider (Supabase/Render/Railway all give you
# one of these directly). SSL is enabled automatically in production — see config/db.ts.
DATABASE_URL=postgresql://user:password@your-db-host:5432/medireach

# ── Auth ──────────────────────────────────────────────────
# Generate a real secret — do not reuse the dev one, and never commit this value:
#   openssl rand -base64 48
# Startup will refuse to run in production with the placeholder value from .env.example.
JWT_SECRET=
JWT_EXPIRES_IN=7d

# ── CORS ──────────────────────────────────────────────────
# Comma-separated list of your deployed frontend origins. Left unset, the API accepts
# requests from anywhere — fine for local dev, not for production.
CORS_ORIGINS=https://your-hospital-web-domain.com,https://your-admin-web-domain.com

# ── Seed demo password (only relevant if you seed demo accounts in production) ──
SEED_DEMO_PASSWORD=
