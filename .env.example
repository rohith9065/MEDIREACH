# ── Server ────────────────────────────────────────────────
PORT=4000
NODE_ENV=development

# ── Database ──────────────────────────────────────────────
# Local Postgres (Phase 1 uses plain lat/lng columns, no PostGIS required)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/medireach
TEST_DATABASE_URL=postgresql://postgres:postgres@localhost:5432/medireach_test

# ── Auth ──────────────────────────────────────────────────
JWT_SECRET=change-this-to-a-long-random-string
JWT_EXPIRES_IN=7d

# ── Seed demo password (all seeded accounts share this in dev) ──
SEED_DEMO_PASSWORD=Passw0rd!

# ── Future phases (placeholders, unused in Phase 1) ──────────
# FCM_SERVER_KEY=
# CLOUDINARY_URL=
# MAP_TILE_PROVIDER_KEY=
