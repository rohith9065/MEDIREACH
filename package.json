{
  "name": "medireach",
  "private": true,
  "version": "0.1.0",
  "description": "MediReach - Real-Time Hospital Availability, Emergency Assistance & Patient Navigation Platform",
  "workspaces": [
    "server",
    "shared",
    "apps/hospital-web",
    "apps/admin-web"
  ],
  "scripts": {
    "dev": "npm run dev --workspace=server",
    "build": "npm run build --workspace=server",
